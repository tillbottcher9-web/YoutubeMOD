    let i = 0;
    const next = () => {
      if (i >= qs.length) return toast('❌ Nicht gefunden');
      const q = qs[i++];
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        if (img.naturalWidth < 100) return next();
        const c = document.createElement('canvas');
        c.width = img.naturalWidth; c.height = img.naturalHeight;

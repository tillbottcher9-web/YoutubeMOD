  // --- Aussehen ---
  sectionTitle(cats.look, 'Farben & Layout');
  toggleRow(cats.look, 'amoled', 'AMOLED-Schwarz', 'Tiefes Schwarz, spart Strom');
  toggleRow(cats.look, 'wideTheater', 'Breiter Kinomodus', 'Mehr Höhe im Theatermodus');
  toggleRow(cats.look, 'compactGrid', 'Kompaktes Grid', 'Engere Video-Abstände');
  toggleRow(cats.look, 'hideScrollBar', 'Scrollbar verstecken', 'Ohne Scrollbalken');

  // --- Tools ---
  sectionTitle(cats.tools, 'Schnellaktionen');
  actionGrid(cats.tools, [
    { icon: '📸', label: 'Screenshot',   handler: takeScreenshot },
    { icon: '🖼', label: 'Thumbnail',    handler: downloadThumbnail },
    { icon: '🔗', label: 'Sauberer Link', handler: copyCleanUrl },
    { icon: '📋', label: 'Video-Info',   handler: copyVideoInfo },
    { icon: '🖥', label: 'Vollbild',      handler: toggleFullscreen },
    { icon: '🎬', label: 'Kino-Modus',   handler: toggleTheater },
    { icon: '📺', label: 'Bild-in-Bild', handler: togglePiP },
    { icon: '↩', label: 'Reset',        handler: () => {
      if (!confirm('Alle Einstellungen zurücksetzen?')) return;
      try { localStorage.removeItem(LS_KEY); } catch (e) {}
      location.reload();
    }},
  ]);
  sectionTitle(cats.tools, 'Hotkeys');
  actionGrid(cats.tools, [
    { icon: '⌨', label: 'Alt+K Panel',   handler: () => toast('Alt+K = Menü öffnen/schließen') },
    { icon: '⌨', label: 'Alt+S Shorts',  handler: () => toast('Alt+S = Shorts ein/aus') },
    { icon: '⌨', label: 'Alt+W Ads',     handler: () => toast('Alt+W = Werbung ein/aus') },
    { icon: '⌨', label: 'Alt+D AMOLED',  handler: () => toast('Alt+D = AMOLED ein/aus') },
    { icon: '⌨', label: 'Alt+P PiP',     handler: () => toast('Alt+P = Bild-in-Bild') },
  ]);

  // Tabs wechseln
  let activeTab = 'playback';
  function switchTab(id) {
    activeTab = id;
    Object.entries(tabEls).forEach(([k, el]) => el.classList.toggle('yti-active', k === id));
    Object.entries(cats).forEach(([k, el]) => el.classList.toggle('yti-active', k === id));
  }
  Object.entries(tabEls).forEach(([k, el]) => el.addEventListener('click', () => switchTab(k)));
  switchTab('playback');

  // Open / Close
  const openPanel = () => panel.classList.add('yti-open');
  const closePanel = () => panel.classList.remove('yti-open');
  btn.addEventListener('click', () => panel.classList.contains('yti-open') ? closePanel() : openPanel());
  closeBtn.addEventListener('click', closePanel);

  // ================== MOUNT & RUN ==================
  document.body.appendChild(btn);
  document.body.appendChild(panel);

  // Klassen anwenden
  for (const [k, v] of Object.entries(state)) {
    if (typeof v === 'boolean') document.body.classList.toggle('yti-' + k, v);
  }
  applySpeed(); applyLoop(); applyAutoHD();

  // Wiederkehrende Checks
  setInterval(() => {
    if (state.skipAds) trySkipAd();
    if (state.autoHD) applyAutoHD();
    if (state.loopVideo) applyLoop();
    if (getVideo() && Math.abs(getVideo().playbackRate - state.speed) > 0.01) applySpeed();
  }, 1500);

  // SPA-Navigation
  document.addEventListener('yt-navigate-finish', () => {
    setTimeout(() => {
      for (const [k, v] of Object.entries(state)) {
        if (typeof v === 'boolean') document.body.classList.toggle('yti-' + k, v);
      }
      boundVideo = null; gainNode = null;
      if (state.volumeBoost) applyVolumeBoost();
      applyAutoHD(); applyLoop(); applySpeed();
    }, 500);
  });

  // Video geladen
  document.addEventListener('loadeddata', e => {
    if (e.target.tagName === 'VIDEO') {
      if (state.loopVideo) e.target.loop = true;
      if (state.speed !== 1.0) e.target.playbackRate = state.speed;
    }
  }, true);

  // Hotkeys
  document.addEventListener('keydown', e => {
    if (e.target.matches('input, textarea, [contenteditable]')) return;
    if (!e.altKey) return;
    const k = e.key.toLowerCase();
    if (k === 'k') { e.preventDefault(); panel.classList.contains('yti-open') ? closePanel() : openPanel(); }
    else if (k === 's') { setState('hideShorts', !state.hideShorts); toast(state.hideShorts ? '✅ Shorts aus' : '❌ Shorts an'); }
    else if (k === 'w') { setState('hideAds', !state.hideAds);       toast(state.hideAds ? '✅ Ads aus' : '❌ Ads an'); }
    else if (k === 'd') { setState('amoled', !state.amoled);         toast(state.amoled ? '🌑 AMOLED an' : '☀ aus'); }
    else if (k === 'p') { e.preventDefault(); togglePiP(); }
  });

  console.log('%c⚙ YouTube+ Mod v2 geladen', 'color:#ff0033;font-weight:bold;font-size:14px');
  console.log('%c⚙ Button unten rechts · Alt+K = Menü · Alt+S/W/D/P = Hotkeys', 'color:#888');
})();
